# Copy to .env and edit. Nothing in this file is required - AstroGuard-X runs fully offline without it.

# --- Gemini (Google GenAI SDK). Get a key at https://aistudio.google.com/apikey -------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_S=20

# --- ECG analyser (TEKNOFEST V23 package, created with Antigravity) -------------------------
# Folder that contains TEKNOFEST_EKG_Yapay_Zeka_Sistemi.py and checkpoints/*.pt
ECG_PACKAGE_PATH=
# Interpreter that has the ECG package dependencies (torch, flask, scipy). Default: current Python.
ECG_PYTHON=
ECG_SERVICE_URL=http://127.0.0.1:5057
ECG_AUTOSTART=1

# --- Risk model ---------------------------------------------------------------------------------
ASTROGUARD_CHECKPOINT=checkpoints/astroguard_v1.pt
ASTROGUARD_AUTOTRAIN=1          # train a compact model on simulated crews if no checkpoint exists
ASTROGUARD_RULE_BLEND=0.65      # weight of the transparent reference-range score (0..1)
ASTROGUARD_MC_SAMPLES=24        # Monte-Carlo samples for the Bayesian uncertainty
SUBJECTIVE_BACKEND=lexicon      # or: transformers

# --- Storage / wiring ----------------------------------------------------------------------------
ASTROGUARD_DB=data/astroguard.db
# If set, the Streamlit UI talks to this FastAPI server instead of running the backend in-process.
ASTROGUARD_API_URL=
ASTROGUARD_CORS=http://localhost:8501
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
